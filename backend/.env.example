# 复制为 .env 后按需修改；.env 不入库
APP__ENV=local
APP__DEBUG=false

DB__URL=postgresql+asyncpg://insurance:insurance@localhost:5433/insurance

# 生产环境必须修改；可用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
AUTH__JWT_SECRET=dev-insecure-jwt-secret-change-me-please
AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=1440

LOG__LEVEL=INFO
LOG__JSON_FORMAT=false

# 条款入库（M2）：MinerU 解析 PDF，DashScope 做向量化与重排
RAG__MINERU_TOKEN=
RAG__DASHSCOPE_API_KEY=

# 对话模型（M4）：任何 OpenAI 兼容接口。默认 DashScope qwen-plus，不填 Key 时复用 RAG__DASHSCOPE_API_KEY
# 换 DeepSeek：LLM__BASE_URL=https://api.deepseek.com  LLM__MODEL=deepseek-chat
# LLM__API_KEY=
# LLM__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM__MODEL=qwen-plus
